<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.constellation.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>@@BINARY@@</string>
    <string>--role</string>
    <string>all</string>
    <string>--database-url</string>
    <string>sqlite://@@DATA@@/constellation.db?mode=rwc</string>
    <string>--data-dir</string>
    <string>@@DATA@@</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@@DATA@@/constellationd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>@@DATA@@/constellationd.stderr.log</string>
</dict>
</plist>
